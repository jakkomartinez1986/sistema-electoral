# =============================================================================
#  Sistema Electoral Estudiantil — variables de entorno de ejemplo
# -----------------------------------------------------------------------------
#  Copia este archivo a `.env` y reemplaza los valores ficticios por los reales
#  de TU proyecto Supabase. NUNCA subas `.env` al repositorio.
#
#  Sistema de claves nuevo de Supabase (2025+): se usan PUBLISHABLE/SECRET en
#  lugar de anon/service_role. La publishable key es pública (va en el cliente);
#  la secret key es equivalente a service_role y vive SOLO en el servidor.
#
#  En Flutter estas variables se inyectan en compilación con --dart-define
#  (ver docs/instalacion.md). No se lee este archivo desde la app.
# =============================================================================

# --- Proyecto Supabase ---
SUPABASE_PROJECT_REF=tu-project-ref
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_JWKS_URL=https://tu-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# --- Clave pública (segura en el cliente) ---
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Clave secreta (equivalente a service_role) ---
# Vive ÚNICAMENTE en el servidor (Edge Functions / CLI). NUNCA en Flutter.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Compatibilidad con Supabase CLI / nombres antiguos ---
# La CLI usa SUPABASE_ACCESS_TOKEN para operar (supabase login / link / db push).
# Es un token personal (sbp_...), NO la secret key. No lo subas al repositorio.
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
